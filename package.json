{
  "name": "@jabraf/use-gmaps",
  "version": "2.0.5",
  "description": "React hook for using Google Maps in React apps.",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "setup": "bash setup-test-app.sh",
    "start": "cd test-app && ./node_modules/.bin/vite",
    "preview": "cd test-app && ./node_modules/.bin/vite build && ./node_modules/.bin/vite preview",
    "prepare": "husky",
    "postbuild": "node -e \"for (const f of ['dist/index.d.ts','dist/index.d.cts']) { const fs = require('fs'); const ref = '/// <reference types=\\\"google.maps\\\" />\\n'; const s = fs.readFileSync(f, 'utf8'); if (!s.startsWith(ref)) fs.writeFileSync(f, ref + s); }\""
  },
  "homepage": "https://github.com/jabranr/use-gmaps#readme",
  "keywords": [
    "google",
    "maps",
    "API",
    "react",
    "hook"
  ],
  "author": {
    "name": "Jabran Rafique",
    "email": "hello@jabran.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jabranr/use-gmaps.git"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "volta": {
    "node": "22.17.0",
    "npm": "10.9.2"
  },
  "prettier": "@jabraf/prettier",
  "devDependencies": {
    "@jabraf/prettier": "^3.0.1",
    "@playwright/test": "^1.54.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "@types/google.maps": "^3.67.0"
  },
  "sideEffects": false,
  "bugs": {
    "url": "https://github.com/jabranr/use-gmaps/issues"
  }
}
